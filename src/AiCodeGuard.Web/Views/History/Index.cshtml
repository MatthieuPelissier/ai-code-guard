@model IReadOnlyList<AnalysisRecord>
@{
    ViewData["Title"] = "Historique";
}

<h1>Historique des analyses</h1>
<p class="muted">Chaque analyse est conservée : c'est la trace du contrôle effectué avant intégration.</p>

@if (Model.Count == 0)
{
    <section class="card empty">
        <p>Aucune analyse pour le moment.</p>
        <a class="btn" asp-controller="Home" asp-action="Index">Lancer une analyse</a>
    </section>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Date (UTC)</th>
                <th>Fichier</th>
                <th>Score</th>
                <th>Verdict</th>
                <th>Problèmes</th>
                <th>Critiques</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Id</td>
                    <td>@a.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><code>@a.FileName</code></td>
                    <td><strong>@a.Score</strong>/100</td>
                    <td><span class="pill pill-@a.Verdict.ToLowerInvariant()">@a.Verdict</span></td>
                    <td>@a.FindingsCount</td>
                    <td>@a.CriticalCount</td>
                    <td><a asp-action="Details" asp-route-id="@a.Id">Détails</a></td>
                </tr>
            }
        </tbody>
    </table>
}
